# Copy to .env and fill in. Never commit .env.
SECRETS_BACKEND=env        # env | aws_ssm

ANTHROPIC_API_KEY=
# Max estimated Claude spend (USD) per rolling 7 days; scoring stops when reached. Empty = no cap.
MAX_WEEKLY_BUDGET_USD=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # only this chat may receive messages or press buttons

# Needed when notifier is discord or both
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=
# Optional one-way fallback (no feedback)
DISCORD_WEBHOOK_URL=

# Only when SECRETS_BACKEND=aws_ssm
AWS_REGION=
SSM_PREFIX=/job-hunter/
